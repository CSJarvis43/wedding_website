# Copy to .env and fill in real values. Never commit .env.
# Every key the app reads must be listed here with a placeholder value.

APP_ENV=development
SECRET_KEY=change-me
ADMIN_EMAILS=admin@example.com

# Local Postgres (docker compose `db` service). Compose builds the backend's
# DATABASE_URL from these; DATABASE_URL below is for running the backend natively.
# Use URL-safe characters (letters, digits, - _ .) since these are pasted into a URL.
POSTGRES_USER=wedding
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wedding
DATABASE_URL=postgresql+psycopg://wedding:change-me@localhost:5432/wedding
